# ── Variables para docker-compose ─────────────────────────────────────────────
# Copia este archivo a .env (en la raíz del proyecto) y ajusta los valores.
#     cp .env.docker.example .env

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-contraseña-fuerte
POSTGRES_DB=inventario

# ── Autenticación (Auth.js) ───────────────────────────────────────────────────
# Genera un secreto con:  npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=cambia-esto-por-un-secreto-aleatorio-largo
# URL pública final de la app (con https:// si usas Caddy/dominio)
AUTH_URL=http://localhost:3000

# ── HTTPS con Caddy (solo si usas el perfil "https") ──────────────────────────
# Dominio que apunta al VPS. Deja el AUTH_URL de arriba como https://ese-dominio
AUTH_DOMAIN=inventario.tudominio.com

# ── App ───────────────────────────────────────────────────────────────────────
# Puerto en el host donde se publica la app (interno siempre 3000)
APP_PORT=3000
SIMILITUD_UMBRAL=0.40
MAX_UPLOAD_MB=10
# Sembrar datos de ejemplo/usuarios de prueba en el primer arranque
SEED_ON_START=true

# ── Cola de sincronización (worker) ───────────────────────────────────────────
# Nº de operaciones que el worker aplica en paralelo a Postgres.
# Súbelo si tienes muchos operarios y la BD lo aguanta; bájalo para proteger la BD.
SYNC_WORKER_CONCURRENCY=5
