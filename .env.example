# ── Base de datos ─────────────────────────────────────────────────────────────
# Cadena de conexión a PostgreSQL. La base de datos debe existir (ver README).
DATABASE_URL="postgresql://postgres:CONTRASEÑA@localhost:5432/inventario?schema=public"

# ── Autenticación (Auth.js / NextAuth v5) ─────────────────────────────────────
# Genera un secreto con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio"
# URL pública de la aplicación (en desarrollo, http://localhost:3000)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ── Cola de sincronización (Redis + BullMQ) ───────────────────────────────────
# Si se define, /api/sync encola las operaciones y el worker (npm run worker)
# las aplica. Si se deja en blanco, la sincronización se aplica directamente.
# REDIS_URL="redis://localhost:6379"
# Nº de operaciones que el worker aplica en paralelo a la BD
# SYNC_WORKER_CONCURRENCY="5"

# ── Almacenamiento de fotos ───────────────────────────────────────────────────
# Proveedor: "local" (sistema de archivos) o "s3" (MinIO / S3 compatible)
STORAGE_PROVIDER="local"
# Carpeta para el proveedor local (relativa a la raíz del proyecto)
UPLOADS_DIR="data/uploads"
# Solo si STORAGE_PROVIDER="s3":
# S3_ENDPOINT="http://localhost:9000"
# S3_BUCKET="inventario"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="us-east-1"

# ── OCR ───────────────────────────────────────────────────────────────────────
# URL del microservicio de OCR de alta precisión (PP-OCRv5; ver docker/ocr).
# Si se deja vacío, el móvil usa siempre tesseract.js local.
# OCR_SERVICE_URL="http://localhost:8000"

# ── Similitudes ───────────────────────────────────────────────────────────────
# Umbral (0 a 1) de la puntuación combinada de trigramas (similarity +
# word_similarity, sin acentos ni mayúsculas). 0.40 recomendado; también se
# puede ajustar por análisis desde el panel de similitudes.
SIMILITUD_UMBRAL="0.40"

# ── Subidas ───────────────────────────────────────────────────────────────────
# Tamaño máximo de imagen en MB
MAX_UPLOAD_MB="10"
